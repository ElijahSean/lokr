# Dependencies and build output
node_modules/
.next/
out/
*.tsbuildinfo

# The dev loop's own bookkeeping: which requirement files have been processed.
# Machine-local, like Qahal's (see DEVELOPMENT.md).
.dev-loop/
.claude/settings.local.json

# Development-process docs: kept on disk for the dev loop, not published
CLAUDE.md
DEVELOPMENT.md
TASKS.md
LEARNINGS.md
LEARNINGS-archive.md
requirements/
.claude/

# Never commit a vault export. Both hold everything; the CSV holds it in plain text.
*.vault
*.csv
# A single exported note: encrypted, but still someone's data
*.lokrnote

# Personal design notes, kept on disk only (marked confidential)
Lokr-Design-Document.docx

# Secrets and local environment (Lokr needs none; guard against adding them)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Test and tool caches
coverage/
.vitest-cache/
.eslintcache

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/
