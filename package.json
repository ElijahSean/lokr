{
  "name": "lokr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "icon:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-LokrIcon.ps1",
    "shortcut:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Install-LokrShortcut.ps1",
    "test:launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-LokrLauncher.ps1",
    "lint": "next lint --dir app --dir components --dir hooks --dir lib --dir tests",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "argon2-browser": "^1.18.0",
    "dexie": "^3.2.4",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
